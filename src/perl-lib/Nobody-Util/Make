#!/usr/bin/make -f

BASE:=$(shell cd ../../.. && pwd)
PCMD:=perl -Mlocal::lib=$(BASE)

stow: install
	echo "make stow"
	bash -c "cd $(BASE) && cd .. && /usr/bin/stow perl-lib"

install: test
	echo "make install"
	$(PCMD) Build install

test: build
	echo "make build"
	$(PCMD) Build test

build: first
	echo "make first"
	$(PCMD) Build

first:
	rm -fr blib
